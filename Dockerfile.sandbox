# TensorUSD sandbox image.
#
# Build (run from repo root, so ./tensorusd is reachable as build context):
#   docker build -f Dockerfile.sandbox -t tensorusd-sandbox:latest .
#
# The image intentionally has NO entrypoint so validators can control exactly
# which phase runs:
#   docker run ... tensorusd-sandbox python /agent/agent.py --setup
#   docker run ... tensorusd-sandbox python /agent/agent.py --infer

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Third-party deps the agent / injected runtime files need.
RUN pip install \
      numpy>=1.26 \
      pandas>=2.0 \
      scikit-learn>=1.3 \
      requests>=2.31 \
      openai>=1.0

# --- tensorusd package: build it into site-packages, then drop the source ---
# Only copy what's needed to build the wheel/sdist, so we don't drag the
# whole repo (tests, .git, validator-only modules, secrets, etc.) into a
# build context that ends up cached in image layers.
COPY pyproject.toml /tmp/build/pyproject.toml
COPY tensorusd /tmp/build/tensorusd

RUN pip install --no-deps /tmp/build && rm -rf /tmp/build

RUN mkdir -p /agent /cache /data/input /data/output

RUN useradd -m -u 1000 sandbox
RUN chown -R sandbox:sandbox /agent /cache /data
USER sandbox

WORKDIR /agent